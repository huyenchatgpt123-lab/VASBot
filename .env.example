# Copy to .env and set strong values before docker compose up
POSTGRES_USER=vabot
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=vabot
SECRET_KEY=change-me-to-a-long-random-secret
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ADMIN_API_KEY=
OPENAI_ORG_ID=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_URL=http://localhost:8000
MAX_UPLOAD_BYTES=20971520
LOGIN_RATE_LIMIT=10/15minutes
# Notification email — Microsoft Graph (default). Leave MAIL_ENABLED=false until ready.
MAIL_ENABLED=false
MAIL_PROVIDER=graph
MAIL_FROM=
MAIL_FROM_NAME=VATask
FRONTEND_URL=http://localhost:3000
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Optional SMTP fallback (only if host allows port 587)
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Web Push (PWA shortcut) — generate keys: python backend/scripts/generate_vapid_keys.py
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@vietanhschool.edu.vn
